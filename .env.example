# PostgreSQL used by Docker Compose and the active application.
# Copy to .env at the repository root. Never commit .env.

POSTGRES_USER=tgr01
POSTGRES_PASSWORD=replace_with_a_strong_local_password
POSTGRES_DB=tgr01
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://tgr01:replace_with_a_strong_local_password@localhost:5432/tgr01
TEST_DATABASE_URL=postgresql://tgr01:replace_with_a_strong_local_password@localhost:5432/tgr01_test

# Operational market policy. Candles remain stored at 1-minute resolution for
# indicators; decisions are paced every 15 minutes. The age ceiling tolerates
# normal source publication gaps while still failing closed on genuinely old data.
MARKET_ASSET=BTC/BRL
MARKET_SYMBOL=BTC-BRL
MARKET_TIMEFRAME=1m
MARKET_DATA_MAX_AGE_SECONDS=1200
DECISION_INTERVAL_SECONDS=900
