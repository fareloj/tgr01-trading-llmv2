# Copy this file to backend/.env and fill only what you need.
# Do not commit backend/.env.

# Official Hybrid RAG Engine (operator/review evidence only)
EXTERNAL_RAG_URL=http://localhost:8090
EXTERNAL_RAG_CORPUS=tgr01-trading-llmv2
EXTERNAL_RAG_TIMEOUT_SECONDS=30
EXTERNAL_RAG_RERANKER_TIMEOUT_SECONDS=15

# Experimental paper-only agents.
#
# Two providers are sanctioned. Roles can be mixed; each role carries its own
# provider, model, temperature and token budget.
#
#   ollama        local daemon at http://localhost:11434/v1 (proxies :cloud tags)
#                 credential: LLM_API_KEY (GROQ_API_KEY accepted as legacy)
#   ollama-cloud  direct API at https://ollama.com/v1
#                 credential: OLLAMA_CLOUD_API_KEY
#   opencode-go   direct API at https://opencode.ai/zen/go/v1
#                 credential: OPENCODE_GO_API_KEY
#                 REQUIRES an x-opencode-session header (set automatically).
#
# QUOTA POLICY: OpenCode Go is a paid subscription with per-model monthly caps.
# Only the Qwen 3.7/3.8 family is sanctioned on that provider, and the defaults
# below deliberately stay on Ollama so routine paper cycles never spend Go quota.
#
# Model tags are provider specific: the Ollama daemon uses the ":cloud" suffix,
# while the direct Ollama Cloud and OpenCode Go APIs use the bare name.
LLM_API_KEY=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=kimi-k2.7-code:cloud
LLM_TIMEOUT_SECONDS=90

# Per-role overrides. Unset roles inherit the defaults in
# backend/agents/model_config.py (news/technical: glm-5.3:cloud, decision:
# kimi-k2.7-code:cloud), which were validated against the real contracts.
# Accepted per role: <ROLE>_MODEL, <ROLE>_PROVIDER, <ROLE>_BASE_URL,
# <ROLE>_TEMPERATURE, <ROLE>_MAX_TOKENS.
#
# NEWS_AGENT_MODEL and TECHNICAL_AGENT_MODEL remain supported for compatibility.
# Example: route one role to the sanctioned Qwen on OpenCode Go.
# NEWS_PROVIDER=opencode-go
# NEWS_MODEL=qwen3.7-plus
# OPENCODE_GO_API_KEY=replace_with_opencode_go_key
# OPENCODE_GO_SESSION_ID=tgr01-paper-multi-agent

# Live data is stored at one-minute resolution for deterministic indicators,
# while decision cycles run every 15 minutes. The 20-minute freshness ceiling
# tolerates source publication gaps but still fails closed on old data.
MARKET_ASSET=BTC/BRL
MARKET_SYMBOL=BTC-BRL
MARKET_TIMEFRAME=1m
MARKET_DATA_MAX_AGE_SECONDS=1200
DECISION_INTERVAL_SECONDS=900
DECISION_MEMORY_WINDOW_SECONDS=7200
DECISION_MEMORY_MAX_EPISODES=8

# GPT-OSS reasoning budget used by the experimental default.
GPT_OSS_MAX_COMPLETION_TOKENS=3000
GPT_OSS_PLANNER_MAX_COMPLETION_TOKENS=2000
GPT_OSS_REASONING_EFFORT=low
NEMOTRON_MAX_COMPLETION_TOKENS=5000
NEMOTRON_PLANNER_MAX_COMPLETION_TOKENS=3500
GLM_MAX_COMPLETION_TOKENS=5000
GLM_PLANNER_MAX_COMPLETION_TOKENS=3500

# Experimental multi-agent analysis. It is disabled and shadow-only by default.
# These assignments do not grant execution authority; the deterministic Risk
# Manager remains the final gate. Validate every exact model tag in the target
# account before starting a campaign.
MULTI_AGENT_ENABLED=false
MULTI_AGENT_SHADOW_MODE=true

# Mercado Bitcoin private API (OAuth2 client_credentials).
# MB_CLIENT_ID is the "API key id" and MB_CLIENT_SECRET is the secret key.
# MB_ACCOUNT_ID is returned by GET /api/v4/accounts after authentication; it is
# not the same value as MB_CLIENT_ID. Keep real values only in backend/.env.
MB_API_BASE_URL=https://api.mercadobitcoin.net/api/v4
MB_CLIENT_ID=replace_with_api_key_id
MB_CLIENT_SECRET=replace_with_api_key_secret
# MB_ACCOUNT_ID=replace_after_read_only_account_discovery

# Private endpoints and real orders remain disabled. Supplying credentials does
# not grant the application permission to execute trades.
REAL_TRADING_ENABLED=false

# Read-only validation sizes. The validator authenticates, reads balances,
# fees and orderbook, and builds BUY/SELL payloads without submitting them.
MB_DRY_RUN_BUY_BRL=1.00
MB_DRY_RUN_SELL_BTC=0.00000150

# Optional legacy Groq fallback/experiments. LLM_* takes precedence when set.
# GROQ_API_KEY_1=replace_with_your_key
# GROQ_API_KEY_2=replace_with_optional_extra_key
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional: review model for deterministic report critique
REVIEW_LLM_BASE_URL=https://api.groq.com/openai/v1
REVIEW_LLM_MODEL=openai/gpt-oss-120b

# Paper execution assumptions. Adjust only for documented experiments.
PAPER_FEE_RATE=0.003
PAPER_MIN_SLIPPAGE_RATE=0.0005
PAPER_MAX_SLIPPAGE_RATE=0.003
PAPER_ATR_SLIPPAGE_FACTOR=0.1

# Optional: OpenRouter experiments
# OPENROUTER_API_KEY=replace_with_your_key
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: direct DeepSeek experiments
# DEEPSEEK_API_KEY=replace_with_your_key
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Real trading is intentionally not implemented/enabled in V2.
# Keep any future real-trading switch false by default.
